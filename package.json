{
  "name": "@dsh-external/dsh-workspace-menu",
  "version": "1.3.0",
  "description": "DSH 主页工作区/会话行增强菜单：置顶、未读、复制、资源管理器打开、归档、分叉、新窗口，以及受围栏保护的删除；界面使用 DSH 官方 UI 组件渲染，偏好写入 Host 设置命名空间。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5 <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <2",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.5 <2",
    "@deepseek-ai/schemastery": ">=3.18 <4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.dev.json && tsc -p tsconfig.test.json",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "tsdown",
    "build:tests": "tsdown --config tsdown.tests.config.ts",
    "build": "npm run build:host && npm run build:client",
    "test": "npm run build:tests && node --import ./tests/platform-stubs.mjs --test lib/tests/logic.mjs",
    "check": "node scripts/check.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
